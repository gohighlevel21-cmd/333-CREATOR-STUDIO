<creator-studio-demo data-api-endpoint="{{ section.settings.api_endpoint | default: 'https://creator-studio-bridge-preview.up.railway.app/api/creator-studio/generate' | escape }}" data-turnstile-site-key="{{ section.settings.turnstile_site_key | escape }}">
  <template>
    <style>
*{box-sizing:border-box}:host{display:block;margin:0;background:#f7f4ef;color:#161513;font:16px system-ui,sans-serif}header{background:#0d0d0d;color:#f7f4ef;padding:18px max(22px,calc((100% - 1080px)/2));font-weight:800;letter-spacing:.12em;white-space:nowrap}main{max-width:1124px;margin:auto;padding:36px 22px}h1{font:700 clamp(42px,7vw,82px)/1 Georgia;margin:10px 0}h2{font-size:19px;margin:0 0 18px}.eyebrow{color:#705618;font-size:12px;font-weight:850;letter-spacing:.14em}.grid{display:grid;grid-template-columns:1fr 1.1fr;gap:20px;margin-top:28px}.panel{background:#fff;border:1px solid #ddd6ca;padding:22px;border-radius:14px}label,legend{font-weight:700;display:block;margin:15px 0 6px}textarea,input[type=text],select{width:100%;padding:12px;border:1px solid #aaa;border-radius:7px;font:inherit}textarea{resize:vertical}button{padding:12px 16px;border:1px solid #26221c;border-radius:7px;background:#fff;color:#161513;font:inherit;font-weight:700;cursor:pointer}button.primary{background:#161513;color:#fff;margin-top:16px}button:disabled{opacity:.45;cursor:default}button[aria-pressed=true]{background:#b8922a;color:#0d0d0d}fieldset{border:0;padding:0;margin:14px 0}legend{margin-bottom:8px}small,.note{color:#605a50}.stage{position:relative;max-width:460px;margin:auto;background:#eeeae3;border-radius:10px}.stage>svg{display:block;width:100%;height:auto}.art{position:absolute;top:34%;left:33%;width:34%;height:36%;display:flex;align-items:center;justify-content:center;flex-direction:column;text-align:center;color:#b8922a;overflow:hidden;font:bold clamp(12px,3vw,27px)/1 Georgia;overflow-wrap:anywhere}.art img{max-width:85%;max-height:85%;object-fit:contain}.art span{max-width:100%;padding:4px}.placeholder{font:700 12px system-ui;letter-spacing:.12em}.notice{background:#f3ead1;padding:10px 12px;border-radius:6px}.revision{border-top:1px solid #ddd6ca;margin-top:22px;padding-top:6px}[hidden]{display:none!important}@media(max-width:730px){.grid{grid-template-columns:1fr}main{padding-top:26px}}
</style>
    <main><div class="eyebrow">FAITH IN REAL LIFE</div><h1>Creator Studio</h1><p>Bring your idea to life on a custom tee.</p><p class="notice"><strong>Preview mode.</strong> Generate a design with AI or place your own finished design on the tee without AI. Price TBD.</p>
<div class="grid">
<form class="panel" id="studio"><h2>01 · Create your design</h2>
<fieldset><legend>How do you want to start?</legend>
<label><input type="radio" name="studio-mode" value="create" checked> Create a design with AI</label>
<label><input type="radio" name="studio-mode" value="upload"> Upload my finished design</label></fieldset>
<div id="create-fields"><label for="idea">Describe your idea</label><textarea id="idea" rows="3" maxlength="500" placeholder="A vintage mountain badge with gold lettering"></textarea>
<label for="ref">Upload a reference</label><input type="file" id="ref" accept="image/png,image/jpeg,image/webp"><div><small>Optional · PNG, JPG or WebP up to 25 MB</small></div>
{% if section.settings.turnstile_site_key != blank %}
<div id="guest-check"></div>
{% else %}
<label for="preview-token">Creator Studio preview token</label><input type="password" id="preview-token" autocomplete="off" spellcheck="false">
{% endif %}
<label for="wording">Exact wording</label><input type="text" id="wording" maxlength="48" placeholder="BY FAITH">
</div><div id="upload-fields" hidden><label for="finished">Upload your finished artwork</label>
<input type="file" id="finished" accept="image/png,image/jpeg,image/webp">
<div><small>PNG, JPG or WebP up to 25 MB. This option bypasses AI. Use a transparent PNG if you want the shirt color to show through.</small></div></div>
<fieldset><legend>Shirt color</legend><button type="button" data-color="Black" aria-pressed="true">Black</button> <button type="button" data-color="White" aria-pressed="false">White</button></fieldset>
<label for="size">Size</label><select id="size"><option>S</option><option selected>M</option><option>L</option><option>XL</option><option>2XL</option><option>3XL</option></select>
<button class="primary" id="preview" type="submit">Preview design</button><p id="status" role="status" aria-live="polite"></p>
<div class="revision" id="revision-panel" hidden><label for="revision-prompt">Request a revision</label><textarea id="revision-prompt" rows="2" maxlength="500" placeholder="Make the lettering larger and remove the border"></textarea><small id="revision-count">2 revisions available</small><br><button id="revise" type="button">Create revision</button></div>
</form>
<section class="panel"><h2>02 · Review your tee</h2>
<p><strong>Comfort Colors 1717</strong> <span id="variant">· Black · M</span></p>
<div class="stage">
  <svg viewBox="0 0 400 390" role="img" aria-label="Illustrated front view of a Comfort Colors 1717 heavyweight tee">
    <defs>
      <linearGradient id="fabric-light" x2="1" y2="1">
        <stop stop-color="#fff" stop-opacity=".16"/>
        <stop offset=".5" stop-color="#fff" stop-opacity="0"/>
        <stop offset="1" stop-color="#000" stop-opacity=".14"/>
      </linearGradient>
      <path id="tee-shape" d="M151 43C136 47 108 48 89 57C69 67 43 91 23 119L62 169L104 144L102 349Q200 359 298 349L296 144L338 169L377 119C357 91 331 67 311 57C292 48 264 47 249 43Q200 64 151 43Z"/>
    </defs>
    <use id="tee" href="#tee-shape" fill="#30302f" stroke="#777" stroke-width="1.5"/>
    <use href="#tee-shape" fill="url(#fabric-light)"/>
    <path d="M151 43Q159 80 200 83Q241 80 249 43Q200 64 151 43Z" fill="#151515" opacity=".24"/>
    <g fill="none" stroke="#777" stroke-opacity=".55" stroke-width="1.2">
      <path d="M151 43Q159 80 200 83Q241 80 249 43M145 44Q153 87 200 90Q247 87 255 44"/>
      <path d="M89 57Q101 97 104 144M311 57Q299 97 296 144M28 115L66 164M372 115L334 164"/>
      <path d="M102 339Q200 349 298 339M102 343Q200 353 298 343"/>
    </g>
  </svg>
  <div class="art" id="art"><span class="placeholder">FRONT PRINT AREA</span></div>
</div>
<button class="primary" id="approve" type="button" disabled>Approve design</button><p id="approval" role="status"></p></section></div></main>
  </template>
</creator-studio-demo>
<script src="{{ 'creator-studio-demo.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "333 Creator Studio",
  "settings": [
    {
      "type": "text",
      "id": "api_endpoint",
      "label": "Server API endpoint"
    },
    {
      "type": "text",
      "id": "turnstile_site_key",
      "label": "Public Turnstile site key"
    }
  ],
  "presets": [
    {
      "name": "333 Creator Studio"
    }
  ]
}
{% endschema %}
